# Copy to .env and fill in. Needed starting Phase 2 (GEMINI_API_KEY) and
# Phase 3 (TELEGRAM_BOT_TOKEN) -- not required for Phase 1.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Comma-separated fallback chain used when a model's free-tier quota is
# exhausted (each model has its own independent daily quota bucket).
GEMINI_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.7-flash,gemini-3.8-flash
TELEGRAM_BOT_TOKEN=

DB_PATH=data/store.db
SHOP_NAME=Nebula Kirana Store
